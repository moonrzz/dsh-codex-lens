{
  "name": "dsh-codex-lens",
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.7-rc.2 || >=0.2.0-rc.2"
  },
  "description": "Codex Lens: inspect a Codex thread from the DSH right sidebar — overview, live activity, workspace files, stats.",
  "icon": "./icon.svg",
  "author": "moonrzz",
  "license": "MIT",
  "homepage": "https://github.com/moonrzz/dsh-codex-lens#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/moonrzz/dsh-codex-lens.git"
  },
  "bugs": {
    "url": "https://github.com/moonrzz/dsh-codex-lens/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "codex",
    "sidebar",
    "threads",
    "developer-tools"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./icon.svg": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "catalog": {
      "category": "tools",
      "summary": {
        "en": "Browse and bind Codex threads in DSH; read history, live activity, workspace files and turn statistics.",
        "zh": "在 DSH 右侧栏浏览并绑定 Codex 线程，读取历史、实时活动、工作区文件与轮次统计。"
      },
      "capabilities": [
        "tools",
        "systemPrompt",
        "connection.fetch",
        "agents"
      ]
    }
  }
}
