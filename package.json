{
  "name": "@local/dsh-codex-bridge",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "description": "Codex Lens: inspect a Codex thread from the DSH right sidebar — overview, live activity, workspace files, stats.",
  "icon": "./icon.svg",
  "author": "moonrzz",
  "license": "MIT",
  "homepage": "https://github.com/moonrzz/dsh-codex-lens#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/moonrzz/dsh-codex-lens.git"
  },
  "bugs": {
    "url": "https://github.com/moonrzz/dsh-codex-lens/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "codex",
    "plugin",
    "sidecar"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./icon.svg": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
